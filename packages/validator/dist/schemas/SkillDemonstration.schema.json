{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://spurprotocol.dev/schemas/SkillDemonstration.schema.json",
    "title": "SkillDemonstration",
    "type": "object",
    "additionalProperties": false,
    "properties": {
        "version": {
            "const": "0.3.0"
        },
        "demonstrationId": {
            "type": "string"
        },
        "skillId": {
            "type": "string"
        },
        "contributorId": {
            "type": "string"
        },
        "contributorPublicKey": {
            "type": "string",
            "description": "PEM-encoded Ed25519 SPKI public key identifying the contributor who signed this demonstration."
        },
        "signature": {
            "type": "string",
            "description": "Base64-encoded Ed25519 signature over the canonical (stably-stringified) SkillDemonstration payload with only the 'signature' field itself omitted -- contributorPublicKey and every other field are covered, so tampering with the claimed identity or any other field after signing invalidates the signature. Signed by the private key matching contributorPublicKey."
        },
        "submittedAt": {
            "type": "string",
            "format": "date-time"
        },
        "media": {
            "type": "array",
            "minItems": 1,
            "items": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                    "type": {
                        "type": "string",
                        "enum": ["video", "motion_capture", "sensor_log", "other"]
                    },
                    "uri": {
                        "type": "string"
                    },
                    "hash": {
                        "type": "string",
                        "pattern": "^sha256:[a-f0-9]{64}$"
                    }
                },
                "required": ["type", "uri", "hash"]
            }
        },
        "consent": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "licenseType": {
                    "type": "string"
                },
                "usageGrant": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    }
                },
                "revocable": {
                    "type": "boolean"
                },
                "attestedAt": {
                    "type": "string",
                    "format": "date-time"
                }
            },
            "required": ["licenseType", "usageGrant", "revocable", "attestedAt"]
        },
        "reviewStatus": {
            "type": "string",
            "enum": ["pending", "approved", "rejected"]
        }
    },
    "required": [
        "version",
        "demonstrationId",
        "skillId",
        "contributorId",
        "contributorPublicKey",
        "signature",
        "submittedAt",
        "media",
        "consent",
        "reviewStatus"
    ]
}
